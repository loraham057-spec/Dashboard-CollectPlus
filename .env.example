# Copiez ce fichier en .env, puis remplacez le secret avant le lancement Docker.
COLLECTPLUS_ADMIN_USERNAME=admin
COLLECTPLUS_ADMIN_PASSWORD=CHANGE_ME_USE_A_LONG_UNIQUE_SECRET
COLLECTPLUS_PUBLIC_BASE_URL=http://localhost:8000
COLLECTPLUS_ALLOWED_ORIGINS=
COLLECTPLUS_PUBLIC_RATE_LIMIT=12
COLLECTPLUS_RATE_LIMIT_SALT=CHANGE_ME_TO_A_RANDOM_SECRET_SALT
COLLECTPLUS_DB=/app/data/collectplus.db
